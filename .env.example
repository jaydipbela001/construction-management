# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# ---- Backend / serverless (Vercel Project Settings + local .env) ----
# Local MongoDB example:
#   mongodb://127.0.0.1:27017/construction_management
# MongoDB Atlas example:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/construction_management?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/construction_management"

# Secret used to sign JWTs. Use a long random string.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Node environment: "development" locally, "production" on Vercel.
NODE_ENV="development"

# Comma separated list of allowed browser origins for CORS.
# Leave empty in production when the frontend and API share the same origin.
FRONTEND_URL="http://localhost:5173"

# Local dev API port (used by server.js only; Vercel ignores this).
PORT="5000"

# ---- Local development only, used by src/scripts/createAdmin.js ----
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin@123"

# ---- Tests only. The integration test suite DROPS this database. ----
# Never point this at production data.
TEST_MONGODB_URI="mongodb://127.0.0.1:27017/construction_test"

# ---- Frontend (Vite) ----
# Leave empty to use the relative "/api" base URL (recommended on Vercel).
VITE_API_BASE_URL=""
# Currency + locale used by the formatters
VITE_CURRENCY="INR"
VITE_LOCALE="en-IN"
